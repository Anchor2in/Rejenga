DATABASE_URL=postgres://rejenga:rejenga@localhost:5432/rejenga
# Where uploaded listing photos are stored (kept out of the public folder; served only to signed-in users)
UPLOAD_DIR=./uploads
# Set to "false" to let new community accounts in without admin approval (technicians always need approval)
REQUIRE_ACCOUNT_APPROVAL=true
# Days a reservation stays open before it expires and the part is released
RESERVATION_DAYS=7
# AI photo check: below this confidence a prediction is flagged for manual review
AI_LOW_CONFIDENCE=0.5
# Set to "false" to switch off the AI photo check (e.g. offline demo machines)
AI_ENABLED=true
